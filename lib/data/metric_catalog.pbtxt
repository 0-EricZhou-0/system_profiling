# AUTO-GENERATED — do not edit by hand.
# Regenerate: ./build/tools/dump_metric_catalog > lib/data/metric_catalog.pbtxt
# Source of truth: kSystemMetrics / kProcessMetrics in
#   lib/src/system_flush_thread.cpp and lib/src/disk_flush_thread.cpp.
# This file is a human-readable reference only — the runtime seeds
# its in-memory MetricCatalog from RegisterBuiltinDescriptors() in
# lib/src/metric_catalog_builtins.cpp, not from this pbtxt.
#
# GPU descriptors are NOT included here — they are chip-specific and
# discovered at runtime via cuptiProfilerHostGetSubMetrics().

metrics {
  fqn: "cpu__cycles_busy.avg.pct_of_peak_sustained_elapsed"
  type: METRIC_TYPE_THROUGHPUT
  entity: "cpu"
  counter: "cycles_busy"
  rollup: "avg"
  submetric: "pct_of_peak_sustained_elapsed"
  unit: UNIT_PCT
  scope: SCOPE_SYSTEM
  peak_constant: 100
  smoothable: true
  description: "Fraction of wall time the CPU was not idle/iowait. From /proc/stat."
}
