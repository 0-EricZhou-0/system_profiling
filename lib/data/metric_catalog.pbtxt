  counter: "cycles_active"
  rollup: "sum"
  submetric: "per_second"
  unit: UNIT_PCT_OF_CORE
  scope: SCOPE_PROCESS
  peak_expr: "ncpus_x_100"
  smoothable: true
  description: "Per-PID on-CPU time as % of one core, aggregated across every thread of the process. Sum of /proc/<pid>/task/*/schedstat sum_exec_runtime deltas (ns) over actual wall-clock between ticks \342\200\224 nanosecond-precise, no CLK_TCK quantization. >100% means multi-core use; the panel peak_expr caps the axis at ncpus \303\227 100."
}
