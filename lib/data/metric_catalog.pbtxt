  fqn: "disk__read_inflight"
  type: METRIC_TYPE_COUNTER
  entity: "disk"
  counter: "read_inflight"
  unit: UNIT_REQUESTS
  scope: SCOPE_DEVICE
  description: "Currently in-flight read requests. /sys/block/<dev>/inflight first column. Render as step \342\200\224 values are instantaneous, not a rate."
}
metrics {
  fqn: "disk__write_inflight"
  type: METRIC_TYPE_COUNTER
  entity: "disk"
  counter: "write_inflight"
  unit: UNIT_REQUESTS
  scope: SCOPE_DEVICE
  description: "Currently in-flight write requests. /sys/block/<dev>/inflight second column. Render as step."
}
metrics {
  fqn: "proc__io_rchar.sum.per_second"
  type: METRIC_TYPE_COUNTER
  entity: "proc"
  counter: "io_rchar"
  rollup: "sum"
  submetric: "per_second"
  unit: UNIT_BYTES_PER_SEC
  scope: SCOPE_PROCESS
  smoothable: true
  description: "Per-PID syscall-layer read rate: /proc/<pid>/io rchar delta over the actual interval. Bytes returned by read()-family calls (read, pread, readv, sendfile, ...) on ANY fd \342\200\224 files, pipes, sockets, ttys \342\200\224 whether they came from the page cache or from storage. Never counts mmap: pages touched through a mapping are invisible here."
}
metrics {
  fqn: "proc__io_wchar.sum.per_second"
  type: METRIC_TYPE_COUNTER
  entity: "proc"
  counter: "io_wchar"
  rollup: "sum"
  submetric: "per_second"
  unit: UNIT_BYTES_PER_SEC
  scope: SCOPE_PROCESS
  smoothable: true
  description: "Per-PID syscall-layer write rate: /proc/<pid>/io wchar delta over the actual interval. Bytes accepted by write()-family calls on ANY fd (files, pipes, sockets, ttys), counted at the call, not when (or whether) they reach storage. Never counts stores through an mmap."
}
metrics {
  fqn: "proc__io_read_bytes.sum.per_second"
  type: METRIC_TYPE_COUNTER
  entity: "proc"
  counter: "io_read_bytes"
  rollup: "sum"
  submetric: "per_second"
  unit: UNIT_BYTES_PER_SEC
  scope: SCOPE_PROCESS
  smoothable: true
  description: "Per-PID storage-layer read rate: /proc/<pid>/io read_bytes delta over the actual interval. Bytes this process caused to be fetched from storage \342\200\224 read() misses AND page faults on mmap\'d files that miss the page cache. Page-cache hits count 0, so a warm read or a warm mmap shows nothing."
}
metrics {
  fqn: "proc__io_write_bytes.sum.per_second"
  type: METRIC_TYPE_COUNTER
  entity: "proc"
  counter: "io_write_bytes"
  rollup: "sum"
  submetric: "per_second"
  unit: UNIT_BYTES_PER_SEC
  scope: SCOPE_PROCESS
  smoothable: true
  description: "Per-PID storage-layer write rate: /proc/<pid>/io write_bytes delta over the actual interval. Bytes of file pages this process DIRTIED in the page cache, counted when dirtied, not at writeback (which may happen much later, or never \342\200\224 see io_cancelled_write_bytes). Writes to pipes and sockets count 0."
}
metrics {
  fqn: "proc__io_cancelled_write_bytes.sum.per_second"
  type: METRIC_TYPE_COUNTER
  entity: "proc"
  counter: "io_cancelled_write_bytes"
  rollup: "sum"
  submetric: "per_second"
  unit: UNIT_BYTES_PER_SEC
  scope: SCOPE_PROCESS
  smoothable: true
  description: "Per-PID rate of dirtied-then-discarded bytes: /proc/<pid>/io cancelled_write_bytes delta over the actual interval. Pages counted in io_write_bytes that were thrown away before writeback (file truncated or deleted while dirty). Bytes that actually reached storage ~= io_write_bytes - io_cancelled_write_bytes."
}
