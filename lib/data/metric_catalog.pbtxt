  type: METRIC_TYPE_COUNTER
  entity: "mem"
  counter: "used_bytes"
  unit: UNIT_BYTES
  scope: SCOPE_SYSTEM
  peak_ref: "mem__capacity_bytes"
  smoothable: true
  description: "MemTotal \342\210\222 MemAvailable. The \'committed-for-real-use\' figure."
}
metrics {
  fqn: "mem__available_bytes"
  type: METRIC_TYPE_COUNTER
  entity: "mem"
  counter: "available_bytes"
  unit: UNIT_BYTES
  scope: SCOPE_SYSTEM
  peak_ref: "mem__capacity_bytes"
  smoothable: true
  description: "/proc/meminfo MemAvailable \342\200\224 what the kernel believes it can give to new allocations without swap."
}
