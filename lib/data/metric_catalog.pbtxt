  fqn: "proc__rss_bytes"
  type: METRIC_TYPE_COUNTER
  entity: "proc"
  counter: "rss_bytes"
  unit: UNIT_BYTES
  scope: SCOPE_PROCESS
  peak_ref: "mem__capacity_bytes"
  smoothable: true
  description: "Resident set size \342\200\224 /proc/<pid>/status VmRSS. Physical pages owned by the PID."
}
